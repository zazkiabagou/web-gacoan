<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mie Gacoan - Self-Order Kiosk (Offline NetBeans App)</title>
    <style>
        /* ==========================================================================
           1. DESIGN TOKENS & PALET WARNA KHAS MIE GACOAN (100% OFFLINE / TANPA CDN)
           ========================================================================== */
        :root {
            --navy-dark: #0f172a;
            --navy-primary: #1e293b;
            --navy-slate: #334155;
            --crimson-red: #e11d48;
            --crimson-hover: #be123c;
            --amber-warm: #f59e0b;
            --amber-light: #fef3c7;
            --bg-offwhite: #f8fafc;
            --surface-white: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-light: #e2e8f0;
            --emerald-ok: #10b981;
            --emerald-bg: #d1fae5;
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.08);
            --shadow-md: 0 4px 14px rgba(15, 23, 42, 0.1);
            --shadow-lg: 0 12px 28px rgba(15, 23, 42, 0.18);
            --radius-md: 12px;
            --radius-lg: 16px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-offwhite);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ==========================================================================
           2. TOP BRAND HEADER & MAIN NAVIGATION TABS
           ========================================================================== */
        header {
            background: linear-gradient(135deg, var(--navy-dark) 0%, var(--navy-primary) 100%);
            color: var(--surface-white);
            padding: 0.9rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 4px solid var(--crimson-red);
            box-shadow: var(--shadow-md);
        }

        .brand-area {
            display: flex;
            align-items: center;
            gap: 0.9rem;
        }

        .brand-logo {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, var(--crimson-red), var(--amber-warm));
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.65rem;
            box-shadow: 0 4px 12px rgba(225, 29, 72, 0.4);
        }

        .brand-text h1 {
            font-size: 1.3rem;
            font-weight: 800;
            letter-spacing: 0.4px;
            color: var(--amber-warm);
        }

        .brand-text p {
            font-size: 0.78rem;
            color: #cbd5e1;
            margin-top: 2px;
        }

        /* Navigasi Tab Utama */
        .main-nav {
            display: flex;
            background: rgba(15, 23, 42, 0.65);
            padding: 4px;
            border-radius: var(--radius-md);
            border: 1px solid var(--navy-slate);
            gap: 4px;
        }

        .nav-tab {
            background: transparent;
            color: #cbd5e1;
            border: none;
            padding: 0.6rem 1.2rem;
            border-radius: 9px;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

        .nav-tab:hover {
            color: var(--surface-white);
            background: rgba(255, 255, 255, 0.08);
        }

        .nav-tab.active {
            background: var(--crimson-red);
            color: var(--surface-white);
            box-shadow: 0 2px 8px rgba(225, 29, 72, 0.4);
        }

        .badge-count {
            background: var(--amber-warm);
            color: var(--navy-dark);
            font-size: 0.75rem;
            font-weight: 800;
            padding: 1px 7px;
            border-radius: 50px;
        }

        .header-tools {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .offline-pill {
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid var(--emerald-ok);
            color: #6ee7b7;
            padding: 0.45rem 0.85rem;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #6ee7b7;
        }

        .btn-oop-info {
            background: var(--navy-slate);
            color: var(--amber-warm);
            border: 1px solid var(--amber-warm);
            padding: 0.5rem 0.9rem;
            border-radius: 9px;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-oop-info:hover {
            background: var(--amber-warm);
            color: var(--navy-dark);
        }

        /* ==========================================================================
           3. VIEW CONTAINERS & SPLIT-SCREEN 70% / 30% LAYOUT
           ========================================================================== */
        .view-section {
            display: none;
            width: 100%;
            max-width: 1440px;
            margin: 1.5rem auto;
            padding: 0 1.5rem;
            flex: 1;
        }

        .view-section.active {
            display: block;
        }

        .kiosk-split {
            display: grid;
            grid-template-columns: 7fr 3fr;
            gap: 1.5rem;
            align-items: start;
        }

        @media (max-width: 1024px) {
            .kiosk-split {
                grid-template-columns: 1fr;
            }
        }

        /* ==========================================================================
           4. PANEL KIRI (70%): FILTER KATEGORI & KATALOG MENU
           ========================================================================== */
        .catalog-panel {
            background: var(--surface-white);
            border-radius: var(--radius-lg);
            padding: 1.5rem;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-light);
        }

        .section-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
            padding-bottom: 0.9rem;
            border-bottom: 2px solid var(--bg-offwhite);
        }

        .section-top h2 {
            font-size: 1.2rem;
            color: var(--navy-dark);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Filter Pills */
        .filter-pills {
            display: flex;
            gap: 0.6rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }

        .pill-btn {
            padding: 0.65rem 1.15rem;
            border-radius: 50px;
            border: 1.5px solid var(--border-light);
            background: var(--bg-offwhite);
            color: var(--navy-slate);
            font-weight: 700;
            font-size: 0.88rem;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .pill-btn:hover {
            border-color: var(--crimson-red);
            color: var(--crimson-red);
        }

        .pill-btn.active {
            background: var(--navy-dark);
            color: var(--amber-warm);
            border-color: var(--navy-dark);
            box-shadow: var(--shadow-sm);
        }

        /* Grid Kartu Menu */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(245px, 1fr));
            gap: 1.2rem;
        }

        .menu-card {
            background: var(--surface-white);
            border: 1.5px solid var(--border-light);
            border-radius: var(--radius-md);
            padding: 1.1rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s;
        }

        .menu-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
            border-color: var(--amber-warm);
        }

        .card-banner {
            height: 92px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.1rem;
            position: relative;
            margin-bottom: 0.85rem;
        }

        .banner-mie { background: linear-gradient(135deg, #ffe4e6, #fecdd3); }
        .banner-minuman { background: linear-gradient(135deg, #e0f2fe, #bae6fd); }
        .banner-dimsum { background: linear-gradient(135deg, #fef3c7, #fde68a); }

        .class-pill {
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(15, 23, 42, 0.85);
            color: var(--amber-warm);
            font-family: monospace;
            font-size: 0.68rem;
            font-weight: 700;
            padding: 3px 7px;
            border-radius: 6px;
        }

        .card-title {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--navy-dark);
            margin-bottom: 4px;
        }

        .card-desc {
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.4;
            margin-bottom: 0.9rem;
        }

        /* Selector Varian Inline di Kartu */
        .variant-box {
            margin-bottom: 0.9rem;
        }

        .variant-label {
            display: block;
            font-size: 0.74rem;
            font-weight: 700;
            color: var(--navy-slate);
            margin-bottom: 5px;
        }

        .variant-select {
            width: 100%;
            padding: 0.5rem 0.65rem;
            border-radius: 8px;
            border: 1.5px solid var(--border-light);
            background: var(--bg-offwhite);
            font-size: 0.83rem;
            font-weight: 700;
            color: var(--navy-dark);
            cursor: pointer;
        }

        .variant-select:focus {
            outline: none;
            border-color: var(--crimson-red);
        }

        .card-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 0.8rem;
            border-top: 1px dashed var(--border-light);
            margin-top: auto;
        }

        .price-tag {
            font-size: 1.08rem;
            font-weight: 800;
            color: var(--crimson-red);
        }

        .btn-add-cart {
            background: var(--navy-dark);
            color: var(--surface-white);
            border: none;
            padding: 0.55rem 0.95rem;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.84rem;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
        }

        .btn-add-cart:hover {
            background: var(--crimson-red);
        }

        .btn-add-cart:active {
            transform: scale(0.96);
        }

        /* ==========================================================================
           5. PANEL KANAN (30%, STICKY): DATA PEMESAN & KERANJANG
           ========================================================================== */
        .cart-panel {
            background: var(--surface-white);
            border-radius: var(--radius-lg);
            padding: 1.4rem;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-light);
            position: sticky;
            top: 88px;
            display: flex;
            flex-direction: column;
            max-height: calc(100vh - 108px);
        }

        .panel-heading {
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--navy-dark);
            padding-bottom: 0.75rem;
            margin-bottom: 1rem;
            border-bottom: 2px solid var(--bg-offwhite);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .customer-inputs {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 0.65rem;
            margin-bottom: 1rem;
            background: var(--bg-offwhite);
            padding: 0.85rem;
            border-radius: var(--radius-md);
            border: 1px solid var(--border-light);
        }

        .input-field label {
            display: block;
            font-size: 0.74rem;
            font-weight: 800;
            color: var(--navy-primary);
            margin-bottom: 4px;
        }

        .input-field input {
            width: 100%;
            padding: 0.55rem 0.7rem;
            border: 1.5px solid #cbd5e1;
            border-radius: 8px;
            font-size: 0.88rem;
            font-weight: 600;
        }

        .input-field input:focus {
            outline: none;
            border-color: var(--crimson-red);
        }

        /* Banner Promo Live */
        .promo-banner {
            background: var(--amber-light);
            border: 1.5px dashed var(--amber-warm);
            color: #92400e;
            padding: 0.65rem 0.85rem;
            border-radius: 10px;
            font-size: 0.8rem;
            margin-bottom: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            line-height: 1.35;
        }

        .promo-banner.unlocked {
            background: var(--emerald-bg);
            border-color: var(--emerald-ok);
            color: #065f46;
            font-weight: 700;
        }

        /* Daftar Item di Keranjang */
        .cart-scroll-area {
            flex: 1;
            overflow-y: auto;
            padding-right: 4px;
            margin-bottom: 0.9rem;
            min-height: 150px;
        }

        .cart-empty {
            text-align: center;
            padding: 2.2rem 1rem;
            color: var(--text-muted);
            font-size: 0.86rem;
        }

        .cart-empty-icon {
            font-size: 2.6rem;
            display: block;
            margin-bottom: 0.5rem;
        }

        .cart-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.7rem;
            border: 1px solid var(--border-light);
            border-radius: 10px;
            margin-bottom: 0.6rem;
            background: var(--bg-offwhite);
            gap: 8px;
        }

        .cart-row-info h4 {
            font-size: 0.88rem;
            font-weight: 800;
            color: var(--navy-dark);
        }

        .cart-row-variant {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--crimson-red);
            margin: 2px 0;
        }

        .cart-row-sub {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-muted);
        }

        .qty-actions {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .qty-btn {
            width: 26px;
            height: 26px;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            background: var(--surface-white);
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .qty-btn:hover {
            background: var(--navy-dark);
            color: white;
        }

        .qty-num {
            font-size: 0.85rem;
            font-weight: 800;
            min-width: 18px;
            text-align: center;
        }

        /* Ringkasan Total */
        .billing-summary {
            border-top: 2px solid var(--bg-offwhite);
            padding-top: 0.8rem;
            display: flex;
            flex-direction: column;
            gap: 0.45rem;
        }

        .bill-line {
            display: flex;
            justify-content: space-between;
            font-size: 0.88rem;
            color: var(--navy-slate);
        }

        .bill-line.promo-line {
            color: var(--emerald-ok);
            font-weight: 700;
        }

        .bill-line.grand-total {
            font-size: 1.15rem;
            font-weight: 900;
            color: var(--navy-dark);
            border-top: 1px solid var(--border-light);
            padding-top: 0.55rem;
            margin-top: 0.2rem;
        }

        .btn-process-order {
            width: 100%;
            margin-top: 0.9rem;
            padding: 0.95rem;
            background: linear-gradient(135deg, var(--crimson-red), #f43f5e);
            color: var(--surface-white);
            border: none;
            border-radius: var(--radius-md);
            font-size: 0.98rem;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(225, 29, 72, 0.35);
            transition: transform 0.15s, background 0.2s;
        }

        .btn-process-order:hover:not(:disabled) {
            background: var(--crimson-hover);
            transform: translateY(-2px);
        }

        .btn-process-order:disabled {
            background: #cbd5e1;
            box-shadow: none;
            cursor: not-allowed;
        }

        /* ==========================================================================
           6. HALAMAN TAB RIWAYAT TRANSAKSI (OFFLINE STORAGE)
           ========================================================================== */
        .history-panel {
            background: var(--surface-white);
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-light);
        }

        .history-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.2rem;
            margin-top: 1.25rem;
        }

        .history-item-card {
            border: 1.5px solid var(--border-light);
            border-radius: var(--radius-md);
            padding: 1.2rem;
            background: var(--bg-offwhite);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 0.75rem;
        }

        .btn-clear-history {
            background: #fee2e2;
            color: var(--crimson-red);
            border: 1px solid #fecaca;
            padding: 0.55rem 1rem;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
        }

        .btn-clear-history:hover {
            background: var(--crimson-red);
            color: white;
        }

        .btn-inspect-receipt {
            background: var(--navy-primary);
            color: white;
            border: none;
            padding: 0.55rem 0.9rem;
            border-radius: 8px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
        }

        /* ==========================================================================
           7. MODAL STRUK DIGITAL & MODAL STRUKTUR CLASS OOP
           ========================================================================== */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(3px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 1rem;
        }

        .modal-backdrop.open {
            display: flex;
        }

        .modal-dialog {
            background: var(--surface-white);
            border-radius: var(--radius-lg);
            width: 100%;
            max-width: 460px;
            padding: 1.5rem;
            box-shadow: var(--shadow-lg);
            max-height: 92vh;
            overflow-y: auto;
            animation: modalZoom 0.2s ease-out;
        }

        @keyframes modalZoom {
            from { transform: scale(0.93); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        /* Desain Struk Thermal Kasir */
        .thermal-receipt {
            background: #fffbeb;
            border: 1.5px dashed #94a3b8;
            padding: 1.4rem;
            font-family: "Courier New", Courier, monospace;
            color: #0f172a;
            border-radius: 8px;
            margin-bottom: 1.1rem;
        }

        .receipt-top {
            text-align: center;
            border-bottom: 1.5px dashed #64748b;
            padding-bottom: 0.75rem;
            margin-bottom: 0.75rem;
        }

        .receipt-top h3 {
            font-size: 1.2rem;
            font-weight: 900;
            letter-spacing: 1px;
        }

        .receipt-info-block {
            font-size: 0.84rem;
            line-height: 1.55;
            border-bottom: 1.5px dashed #64748b;
            padding-bottom: 0.75rem;
            margin-bottom: 0.75rem;
        }

        .receipt-item-list {
            font-size: 0.84rem;
            border-bottom: 1.5px dashed #64748b;
            padding-bottom: 0.75rem;
            margin-bottom: 0.75rem;
        }

        .r-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
            gap: 8px;
        }

        .receipt-confirm-box {
            text-align: center;
            margin-top: 1rem;
            padding-top: 0.75rem;
            border-top: 1.5px dashed #64748b;
            font-weight: 900;
            font-size: 0.92rem;
            color: #065f46;
        }

        /* Kartu Penjelasan OOP di Modal */
        .oop-doc-card {
            background: var(--bg-offwhite);
            border-left: 4px solid var(--crimson-red);
            padding: 0.85rem 1rem;
            border-radius: 8px;
            margin-bottom: 0.8rem;
        }

        .oop-doc-card h4 {
            font-size: 0.92rem;
            color: var(--navy-dark);
            margin-bottom: 4px;
        }

        .oop-doc-card p {
            font-size: 0.82rem;
            color: var(--navy-slate);
            line-height: 1.45;
        }

        /* Toast Notifikasi Pengganti alert() */
        .toast-box {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%) translateY(120px);
            background: var(--navy-dark);
            color: var(--surface-white);
            padding: 0.85rem 1.4rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.88rem;
            box-shadow: var(--shadow-lg);
            border-left: 5px solid var(--amber-warm);
            z-index: 2000;
            transition: transform 0.28s ease;
        }

        .toast-box.visible {
            transform: translateX(-50%) translateY(0);
        }
    </style>
</head>
<body>

    <!-- ======================================================================
         HEADER & NAVIGASI UTAMA
         ====================================================================== -->
    <header>
        <div class="brand-area">
            <div class="brand-logo">🍜</div>
            <div class="brand-text">
                <h1>MIE GACOAN — SELF-ORDER KIOSK</h1>
                <p>Aplikasi Web Offline Berbasis PBO (Apache NetBeans Ready)</p>
            </div>
        </div>

        <nav class="main-nav">
            <button class="nav-tab active" id="tab-order" onclick="switchMainView('order')">
                🍽️ Menu Pemesanan
            </button>
            <button class="nav-tab" id="tab-history" onclick="switchMainView('history')">
                📜 Riwayat Transaksi <span class="badge-count" id="nav-history-count">0</span>
            </button>
        </nav>

        <div class="header-tools">
            <div class="offline-pill">
                <span class="status-dot"></span> OFFLINE MODE
            </div>
            <button class="btn-oop-info" onclick="openModal('modal-oop')">
                🧩 Struktur Class OOP
            </button>
        </div>
    </header>

    <!-- ======================================================================
         VIEW 1: MENU PEMESANAN (SPLIT-SCREEN 70% KIRI / 30% KANAN)
         ====================================================================== -->
    <main class="view-section active" id="view-order">
        <div class="kiosk-split">
            
            <!-- PANEL KIRI (70%): KATALOG MENU & FILTER -->
            <section class="catalog-panel">
                <div class="section-top">
                    <h2>🔥 Pilih Menu Mie Gacoan Favoritmu</h2>
                    <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">
