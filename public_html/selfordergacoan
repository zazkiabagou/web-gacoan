        ];

        /* ======================================================================
           C. STATE MANAGEMENT & LOCALSTORAGE
           ====================================================================== */
        let currentCategory = 'semua';
        let cartItems = []; // Menyimpan objek { menuInstance, qty }
        let pendingTransaction = null;
        const LOCAL_STORAGE_KEY = 'gacoan_offline_kiosk_transactions';

        function getSavedHistory() {
            try {
                const raw = localStorage.getItem(LOCAL_STORAGE_KEY);
                return raw ? JSON.parse(raw) : [];
            } catch (err) {
                return [];
            }
        }

        function updateHistoryCounter() {
            const list = getSavedHistory();
            document.getElementById('nav-history-count').textContent = list.length;
        }

        function showToast(msg) {
            const toast = document.getElementById('toast-message');
            toast.textContent = msg;
            toast.classList.add('visible');
            setTimeout(() => toast.classList.remove('visible'), 2600);
        }

        /* ======================================================================
           D. RENDER KATALOG & FILTER KATEGORI
           ====================================================================== */
        function filterCategory(category, btnEl) {
            currentCategory = category;
            document.querySelectorAll('.pill-btn').forEach(b => b.classList.remove('active'));
            btnEl.classList.add('active');
            renderMenuGrid();
        }

        function renderMenuGrid() {
            const container = document.getElementById('menu-grid-container');
            container.innerHTML = '';

            const filtered = currentCategory === 'semua'
                ? CATALOG_ITEMS
                : CATALOG_ITEMS.filter(item => item.kategori === currentCategory);

            filtered.forEach(item => {
                const bannerClass = item.kategori === 'mie'
                    ? 'banner-mie'
                    : (item.kategori === 'minuman' ? 'banner-minuman' : 'banner-dimsum');

                const classTag = item.kategori === 'mie'
                    ? 'MieGacoan'
                    : (item.kategori === 'minuman' ? 'Minuman' : 'Dimsum');

                const optionsHtml = item.varianOpsi
                    .map(opt => `<option value="${opt}">${opt}</option>`)
                    .join('');

                const card = document.createElement('div');
                card.className = 'menu-card';
                card.innerHTML = `
                    <div>
                        <div class="card-banner ${bannerClass}">
                            <span>${item.ikon}</span>
                            <span class="class-pill">${classTag}</span>
                        </div>
                        <h3 class="card-title">${item.nama}</h3>
                        <p class="card-desc">${item.deskripsi}</p>
                    </div>
                    <div>
                        <div class="variant-box">
                            <label class="variant-label" for="sel-${item.id}">${item.varianLabel}</label>
                            <select class="variant-select" id="sel-${item.id}">
                                ${optionsHtml}
                            </select>
                        </div>
                        <div class="card-bottom">
                            <span class="price-tag">Rp ${item.harga.toLocaleString('id-ID')}</span>
                            <button class="btn-add-cart" onclick="addItemToCart('${item.id}')">+ Tambah</button>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        /* ======================================================================
           E. INTERAKSI KERANJANG & INSTANSIASI SUBCLASS OOP
           ====================================================================== */
        function addItemToCart(itemId) {
            const itemData = CATALOG_ITEMS.find(i => i.id === itemId);
            if (!itemData) return;

            const selectedVariant = document.getElementById(`sel-${itemId}`).value;

            // Instansiasi Subclass OOP sesuai kategori menu
            let menuInstance;
            if (itemData.kategori === 'mie') {
                menuInstance = new MieGacoan(itemData.nama, itemData.harga, selectedVariant);
            } else if (itemData.kategori === 'minuman') {
                menuInstance = new Minuman(itemData.nama, itemData.harga, selectedVariant);
            } else {
                menuInstance = new Dimsum(itemData.nama, itemData.harga, selectedVariant);
            }

            const infoText = menuInstance.tampilkanInfo(); // Panggil @Override tampilkanInfo()
            const existingIndex = cartItems.findIndex(c => c.menuInstance.tampilkanInfo() === infoText);

            if (existingIndex > -1) {
                cartItems[existingIndex].qty += 1;
            } else {
                cartItems.push({
                    menuInstance: menuInstance,
                    kategori: itemData.kategori,
                    qty: 1
                });
            }

            showToast(`✅ ${infoText} ditambahkan ke keranjang!`);
            renderCart();
        }

        function updateItemQty(index, change) {
            cartItems[index].qty += change;
            if (cartItems[index].qty <= 0) {
                cartItems.splice(index, 1);
            }
            renderCart();
        }

        function renderCart() {
            const listArea = document.getElementById('cart-list-area');
            const submitBtn = document.getElementById('btn-submit-order');

            if (cartItems.length === 0) {
                listArea.innerHTML = `
                    <div class="cart-empty">
                        <span class="cart-empty-icon">🛍️</span>
                        Keranjang masih kosong.<br>Silakan pilih menu di sebelah kiri.
                    </div>
                `;
                submitBtn.disabled = true;
                updateBillingDisplay(0, 0, 0, 0);
                return;
            }

            submitBtn.disabled = false;
            listArea.innerHTML = '';

            let subtotal = 0;
            let totalDrinksCount = 0;

            cartItems.forEach((entry, idx) => {
                const mObj = entry.menuInstance;
                const linePrice = mObj.getHarga() * entry.qty;
                subtotal += linePrice;

                if (mObj instanceof Minuman) {
                    totalDrinksCount += entry.qty;
                }

                // Ambil detail varian dari method getter subclass
                let variantDetail = '';
                if (mObj instanceof MieGacoan) variantDetail = mObj.getLevelPedas();
                else if (mObj instanceof Minuman) variantDetail = mObj.getTipeSajian();
                else if (mObj instanceof Dimsum) variantDetail = mObj.getPorsi();

                const row = document.createElement('div');
                row.className = 'cart-row';
                row.innerHTML = `
                    <div class="cart-row-info">
                        <h4>${mObj.getNamaMenu()}</h4>
                        <div class="cart-row-variant">${variantDetail}</div>
                        <div class="cart-row-sub">Rp ${linePrice.toLocaleString('id-ID')}</div>
                    </div>
                    <div class="qty-actions">
                        <button class="qty-btn" onclick="updateItemQty(${idx}, -1)">-</button>
                        <span class="qty-num">${entry.qty}</span>
                        <button class="qty-btn" onclick="updateItemQty(${idx}, 1)">+</button>
                    </div>
                `;
                listArea.appendChild(row);
            });

            // Gunakan method hitungTotal() dari class Pesanan
            const tempOrder = new Pesanan(null, []);
            const calc = tempOrder.hitungTotal(subtotal, totalDrinksCount);
            updateBillingDisplay(calc.subtotal, calc.diskon, calc.totalAkhir, totalDrinksCount);
        }

        function updateBillingDisplay(subtotal, diskon, totalAkhir, drinkCount) {
            document.getElementById('text-subtotal').textContent = `Rp ${subtotal.toLocaleString('id-ID')}`;
            document.getElementById('text-discount').textContent = `- Rp ${diskon.toLocaleString('id-ID')}`;
            document.getElementById('text-grandtotal').textContent = `Rp ${totalAkhir.toLocaleString('id-ID')}`;

            const promoBox = document.getElementById('promo-indicator');
            const promoMsg = document.getElementById('promo-message');

            if (diskon > 0) {
                promoBox.classList.add('unlocked');
                promoMsg.innerHTML = `🎉 <strong>Promo Aktif:</strong> Diskon Rp 2.000 beli ≥ 2 Minuman (${drinkCount} gelas)!`;
            } else {
                promoBox.classList.remove('unlocked');
                promoMsg.innerHTML = `Beli minimal <strong>2 Minuman</strong> otomatis dapat diskon <strong>Rp 2.000</strong>!`;
            }
        }

        /* ======================================================================
           F. PROSES PESANAN & CETAK STRUK DIGITAL (OOP EXECUTION)
           ====================================================================== */
        function handleProcessOrder() {
            const namaVal = document.getElementById('cust-name').value.trim();
            const mejaVal = document.getElementById('cust-table').value.trim();

            if (!namaVal) {
                showToast('⚠️ Harap masukkan Nama Pelanggan terlebih dahulu!');
                document.getElementById('cust-name').focus();
                return;
            }
            if (!mejaVal || parseInt(mejaVal, 10) <= 0) {
                showToast('⚠️ Harap masukkan Nomor Meja yang valid!');
                document.getElementById('cust-table').focus();
                return;
            }

            // 1. Instansiasi Entity Class Pelanggan
            const pelangganObj = new Pelanggan(namaVal, parseInt(mejaVal, 10));

            // 2. Kumpulkan array instance Menu dari keranjang
            const menuInstances = cartItems.map(c => c.menuInstance);

            // 3. Instansiasi Transaction Class Pesanan (Composition)
            const pesananObj = new Pesanan(pelangganObj, menuInstances);

            // 4. Jalankan Dependency method prosesPesanan()
            const dependencyLog = pesananObj.prosesPesanan(pelangganObj, menuInstances);

            // 5. Hitung total menggunakan Method Overloading hitungTotal()
            let subtotal = 0;
            let drinkCount = 0;
            const serializedItems = [];

            cartItems.forEach(entry => {
                const m = entry.menuInstance;
                const itemTotal = m.getHarga() * entry.qty;
                subtotal += itemTotal;
                if (m instanceof Minuman) drinkCount += entry.qty;

                serializedItems.push({
                    info: m.tampilkanInfo(),
                    qty: entry.qty,
                    hargaSatuan: m.getHarga(),
                    subtotalItem: itemTotal
                });
            });

            const billing = pesananObj.hitungTotal(subtotal, drinkCount);

            pendingTransaction = {
                orderId: 'GCN-' + Math.floor(100000 + Math.random() * 900000),
                timestamp: pesananObj.timestamp,
                namaPelanggan: pelangganObj.getNamaPelanggan(),
                nomorMeja: pelangganObj.getNomorMeja(),
                items: serializedItems,
                subtotal: billing.subtotal,
                diskon: billing.diskon,
                totalBayar: billing.totalAkhir,
                oopLog: dependencyLog
            };

            renderThermalReceipt(pendingTransaction, false);
            openModal('modal-receipt');
        }

        function renderThermalReceipt(trx, isHistoryInspection) {
            const target = document.getElementById('receipt-render-target');

            const itemsRowsHtml = trx.items.map(it => `
                <div class="r-row">
                    <span>${it.qty}x ${it.info}</span>
                    <span>Rp ${it.subtotalItem.toLocaleString('id-ID')}</span>
                </div>
            `).join('');

            target.innerHTML = `
                <div class="receipt-top">
                    <h3>MIE GACOAN KIOSK</h3>
                    <div style="font-size:0.75rem;">Self-Order Digital Receipt</div>
                    <div style="font-size:0.74rem; margin-top:4px; font-weight:bold;">ID: ${trx.orderId}</div>
                </div>
                <div class="receipt-info-block">
                    <div><strong>Pelanggan :</strong> ${trx.namaPelanggan}</div>
                    <div><strong>No. Meja  :</strong> Meja ${trx.nomorMeja}</div>
                    <div><strong>Waktu     :</strong> ${trx.timestamp}</div>
                    <div style="font-size:0.7rem; color:#475569; margin-top:4px;">[${trx.oopLog}]</div>
                </div>
                <div class="receipt-item-list">
                    ${itemsRowsHtml}
                </div>
                <div style="font-size:0.86rem; line-height:1.6;">
                    <div class="r-row">
                        <span>Subtotal</span>
                        <span>Rp ${trx.subtotal.toLocaleString('id-ID')}</span>
                    </div>
                    <div class="r-row" style="color:#059669; font-weight:bold;">
                        <span>Diskon Promo</span>
                        <span>- Rp ${trx.diskon.toLocaleString('id-ID')}</span>
                    </div>
                    <div class="r-row" style="font-size:1.05rem; font-weight:900; border-top:1px solid #64748b; padding-top:6px; margin-top:6px;">
                        <span>TOTAL BAYAR</span>
                        <span>Rp ${trx.totalBayar.toLocaleString('id-ID')}</span>
                    </div>
                </div>
                <div class="receipt-confirm-box">
                    ✅ Pesanan Anda segera disiapkan!
                </div>
            `;

            // Atur tombol modal sesuai konteks (Checkout baru vs Lihat Riwayat)
            document.getElementById('btn-save-new-order').style.display = isHistoryInspection ? 'none' : 'block';
            document.getElementById('btn-close-receipt-only').style.display = isHistoryInspection ? 'block' : 'none';
        }

        function saveOrderAndReset() {
            if (pendingTransaction) {
                const history = getSavedHistory();
                history.unshift(pendingTransaction);
                localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(history));
                updateHistoryCounter();
            }

            // Reset keranjang & form untuk pelanggan berikutnya
            cartItems = [];
            pendingTransaction = null;
            document.getElementById('cust-name').value = '';
            document.getElementById('cust-table').value = '';
            renderCart();
            closeModal('modal-receipt');
            showToast('💾 Transaksi berhasil disimpan ke Riwayat Lokal!');
        }

        /* ======================================================================
           G. NAVIGASI TAB & RIWAYAT TRANSAKSI LOKAL
           ====================================================================== */
        function switchMainView(viewName) {
            document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.view-section').forEach(v => v.classList.remove('active'));

            if (viewName === 'order') {
                document.getElementById('tab-order').classList.add('active');
                document.getElementById('view-order').classList.add('active');
            } else {
                document.getElementById('tab-history').classList.add('active');
                document.getElementById('view-history').classList.add('active');
                renderHistoryGrid();
            }
        }

        function renderHistoryGrid() {
            const container = document.getElementById('history-grid-container');
            const history = getSavedHistory();

            if (history.length === 0) {
                container.innerHTML = `
                    <div style="grid-column: 1 / -1; text-align:center; padding:3rem 1rem; color:var(--text-muted);">
                        <div style="font-size:3rem; margin-bottom:0.5rem;">📭</div>
                        <p>Belum ada riwayat transaksi yang tersimpan secara offline.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = '';
            history.forEach((trx, idx) => {
                const summaryText = trx.items.map(i => `${i.qty}x ${i.info}`).join(', ');
                const card = document.createElement('div');
                card.className = 'history-item-card';
                card.innerHTML = `
                    <div>
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                            <span style="font-weight:800; color:var(--navy-dark); font-size:1rem;">
                                ${trx.namaPelanggan} • Meja ${trx.nomorMeja}
                            </span>
                            <span style="font-weight:800; color:var(--crimson-red); font-size:1rem;">
                                Rp ${trx.totalBayar.toLocaleString('id-ID')}
                            </span>
                        </div>
                        <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:8px;">
                            <strong>${trx.orderId}</strong> • ${trx.timestamp}
                        </div>
                        <p style="font-size:0.84rem; color:var(--navy-slate); line-height:1.45;">
                            ${summaryText}
                        </p>
                    </div>
                    <button class="btn-inspect-receipt" onclick="inspectPastReceipt(${idx})">
                        🧾 Lihat Detail Struk
                    </button>
                `;
                container.appendChild(card);
            });
        }

        function inspectPastReceipt(index) {
            const history = getSavedHistory();
            if (history[index]) {
                renderThermalReceipt(history[index], true);
                openModal('modal-receipt');
            }
        }

        function clearAllHistory() {
            localStorage.removeItem(LOCAL_STORAGE_KEY);
            updateHistoryCounter();
            renderHistoryGrid();
            showToast('🗑️ Seluruh riwayat transaksi lokal telah dihapus.');
        }

        function openModal(id) {
            document.getElementById(id).classList.add('open');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('open');
        }

        // Inisialisasi aplikasi saat halaman dimuat
        window.onload = function () {
            renderMenuGrid();
            renderCart();
            updateHistoryCounter();
        };
    </script>
</body>
</html>