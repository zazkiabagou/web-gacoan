    <script>
        /* ======================================================================
           A. DEFINISI CLASS OOP (PERTEMUAN 1 - 5)
           ====================================================================== */

        // 1. Superclass Menu (Pertemuan 1 & 2: Class, Object, Encapsulation)
        class Menu {
            #namaMenu;
            #harga;

            constructor(namaMenu, harga) {
                this.#namaMenu = namaMenu;
                this.#harga = harga;
            }

            getNamaMenu() {
                return this.#namaMenu;
            }

            getHarga() {
                return this.#harga;
            }

            setHarga(hargaBaru) {
                if (hargaBaru >= 0) {
                    this.#harga = hargaBaru;
                }
            }

            tampilkanInfo() {
                return `${this.#namaMenu} - Rp ${this.#harga.toLocaleString('id-ID')}`;
            }
        }

        // 2. Subclass MieGacoan (Pertemuan 1, 3, & 4: Inheritance, super(), @Override)
        class MieGacoan extends Menu {
            #levelPedas;

            constructor(namaMenu, harga, levelPedas) {
                super(namaMenu, harga);
                this.#levelPedas = levelPedas;
            }

            getLevelPedas() {
                return this.#levelPedas;
            }

            // @Override tampilkanInfo()
            tampilkanInfo() {
                return `${this.getNamaMenu()} (${this.#levelPedas})`;
            }
        }

        // 3. Subclass Minuman (Pertemuan 1, 3, & 4: Inheritance, super(), @Override)
        class Minuman extends Menu {
            #tipeSajian;

            constructor(namaMenu, harga, tipeSajian) {
                super(namaMenu, harga);
                this.#tipeSajian = tipeSajian;
            }

            getTipeSajian() {
                return this.#tipeSajian;
            }

            // @Override tampilkanInfo()
            tampilkanInfo() {
                return `${this.getNamaMenu()} (${this.#tipeSajian})`;
            }
        }

        // 4. Subclass Dimsum (Pertemuan 1, 3, & 4: Inheritance, super(), @Override)
        class Dimsum extends Menu {
            #porsi;

            constructor(namaMenu, harga, porsi = "3 Pcs") {
                super(namaMenu, harga);
                this.#porsi = porsi;
            }

            getPorsi() {
                return this.#porsi;
            }

            // @Override tampilkanInfo()
            tampilkanInfo() {
                return `${this.getNamaMenu()} (${this.#porsi})`;
            }
        }

        // 5. Entity Class Pelanggan (Pertemuan 2: Encapsulation)
        class Pelanggan {
            #namaPelanggan;
            #nomorMeja;

            constructor(namaPelanggan, nomorMeja) {
                this.#namaPelanggan = namaPelanggan;
                this.#nomorMeja = nomorMeja;
            }

            getNamaPelanggan() {
                return this.#namaPelanggan;
            }

            setNamaPelanggan(nama) {
                this.#namaPelanggan = nama;
            }

            getNomorMeja() {
                return this.#nomorMeja;
            }

            setNomorMeja(meja) {
                this.#nomorMeja = meja;
            }
        }

        // 6. Transaction Class Pesanan (Pertemuan 3 & 5: Composition, Dependency, Method Overloading)
        class Pesanan {
            constructor(pelanggan, items) {
                this.pelanggan = pelanggan; // Composition: holds Pelanggan instance
                this.items = items;         // Composition: holds array of Menu subclass instances
                this.timestamp = new Date().toLocaleString('id-ID');
            }

            // Dependency: menerima objek pelanggan & items sebagai parameter method
            prosesPesanan(pelanggan, items) {
                return `Order diproses untuk ${pelanggan.getNamaPelanggan()} (Meja ${pelanggan.getNomorMeja()}) - ${items.length} varian item`;
            }

            // Simulasi Method Overloading: hitungTotal(subtotal, jumlahMinuman)
            hitungTotal(subtotal, jumlahMinuman = 0) {
                const diskon = jumlahMinuman >= 2 ? 2000 : 0;
                return {
                    subtotal: subtotal,
                    diskon: diskon,
                    totalAkhir: subtotal - diskon
                };
            }
        }

